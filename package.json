{
  "name": "streamx-search",
  "version": "0.1.0",
  "description": "Framework-independent search UI components",
  "private": false,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "docs"
  ],
  "exports": {
    "./search-inline": {
      "types": "./dist/search-inline.d.ts",
      "import": "./dist/streamx-search-inline.js"
    },
    "./search-results-panel": {
      "types": "./dist/search-results-panel.d.ts",
      "import": "./dist/streamx-search-results-panel.js"
    },
    "./search-tabs": {
      "types": "./dist/search-tabs.d.ts",
      "import": "./dist/streamx-search-tabs.js"
    },
    "./eds/search-results-panel": {
      "types": "./dist/eds/decorate-results-panel.d.ts",
      "import": "./dist/eds/search-results-panel.js"
    },
    "./eds/search-tabs": {
      "types": "./dist/eds/decorate-search-tabs.d.ts",
      "import": "./dist/eds/search-tabs.js"
    },
    "./eds/search-tab": {
      "types": "./dist/eds/decorate-search-tab.d.ts",
      "import": "./dist/eds/search-tab.js"
    },
    "./streamx-search.css": "./dist/streamx-search.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "fix": "eslint . --fix && prettier . --write",
    "prepare": "husky",
    "lint-staged": "lint-staged",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.8.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.12",
    "vite-plugin-dts": "^5.0.3"
  },
  "lint-staged": {
    "*.{js,ts,json,css,md}": [
      "prettier --write"
    ]
  }
}
